{
  "manifest_version": 3,
  "name": "Meeting Recorder — AI Meeting Assistant",
  "version": "0.1.0",
  "description": "Record a browser meeting (Google Meet, Zoom web) with everyone's audio and send it to your AI Meeting Assistant for a summary.",
  "permissions": ["tabCapture", "offscreen", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:5173/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Recorder"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
